{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "family.bothe.chargeiq",
  "version": "1.0.0",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Charge IQ"
  },
  "description": {
    "en": "EV charging orchestration using OCPP."
  },
  "category": [
    "energy"
  ],
  "brandColor": "#16A34A",
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getSchedule": {
      "method": "GET",
      "path": "/getSchedule"
    },
    "setSchedule": {
      "method": "POST",
      "path": "/setSchedule"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "John Bothe",
    "email": "jbothe@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Charging started"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_started"
      },
      {
        "title": {
          "en": "Charging stopped"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_stopped"
      },
      {
        "title": {
          "en": "Charge mode changed"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "mode_changed"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "!{{Is|Is not}} charging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "is_charging"
      },
      {
        "title": {
          "en": "Charge mode !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "Charge mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "manual",
                "label": {
                  "en": "Manual"
                }
              },
              {
                "id": "scheduled",
                "label": {
                  "en": "Scheduled"
                }
              },
              {
                "id": "solar",
                "label": {
                  "en": "Solar surplus"
                }
              }
            ]
          }
        ],
        "id": "mode_is"
      },
      {
        "title": {
          "en": "!{{Is|Is not}} within a schedule window"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "within_schedule"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Set current limit"
        },
        "titleFormatted": {
          "en": "Set current limit to [[current]] A"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "range",
            "name": "current",
            "title": {
              "en": "Current (A)"
            },
            "min": 6,
            "max": 32,
            "step": 1,
            "value": 16,
            "label": " A",
            "labelDecimals": 0
          }
        ],
        "id": "set_current_limit"
      },
      {
        "title": {
          "en": "Start charging"
        },
        "hint": {
          "en": "Manual start until the next schedule boundary"
        },
        "titleFormatted": {
          "en": "Start charging at [[current]] A"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "range",
            "name": "current",
            "title": {
              "en": "Current (A)"
            },
            "min": 6,
            "max": 32,
            "step": 1,
            "value": 16,
            "label": " A",
            "labelDecimals": 0
          }
        ],
        "id": "start_charging"
      },
      {
        "title": {
          "en": "Stop charging"
        },
        "hint": {
          "en": "Manual stop until the next schedule boundary"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "stop_charging"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "EV Charger"
      },
      "class": "evcharger",
      "capabilities": [
        "evcharger_charging",
        "charge_current_limit",
        "charge_mode",
        "evcharger_charging_state",
        "measure_solar_surplus",
        "charger_status",
        "measure_power",
        "measure_current",
        "measure_voltage",
        "meter_power"
      ],
      "capabilitiesOptions": {
        "evcharger_charging_state": {
          "title": {
            "en": "Charging State"
          }
        },
        "meter_power": {
          "title": {
            "en": "Energy (total)"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/charger/assets/images/small.png",
        "large": "/drivers/charger/assets/images/large.png",
        "xlarge": "/drivers/charger/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "charger",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Electrical"
          },
          "children": [
            {
              "id": "phases",
              "type": "number",
              "label": {
                "en": "Phases"
              },
              "hint": {
                "en": "How many phases the charger is wired on (1 or 3). Used with Nominal voltage to convert between watts and amps everywhere, and sent to the charger in every charging profile."
              },
              "value": 1,
              "min": 1,
              "max": 3,
              "step": 1
            },
            {
              "id": "voltage",
              "type": "number",
              "label": {
                "en": "Nominal voltage (V)"
              },
              "hint": {
                "en": "Grid voltage used with Phases for watt/amp conversions in solar and household-cap calculations. Use the nominal value for your grid (e.g. 230) - it doesn't need to track the live measured voltage."
              },
              "value": 230,
              "min": 100,
              "max": 480
            },
            {
              "id": "minAmps",
              "type": "number",
              "label": {
                "en": "Minimum current (A)"
              },
              "hint": {
                "en": "Lowest current ever sent to the charger once it's told to charge - manual, scheduled, and solar targets are all floored to this. Also the surplus threshold: solar charging only starts once available surplus reaches at least this many amps."
              },
              "value": 6,
              "min": 1,
              "max": 32
            },
            {
              "id": "maxAmps",
              "type": "number",
              "label": {
                "en": "Maximum current (A)"
              },
              "hint": {
                "en": "Highest current ever sent to the charger, in any mode. Manual, scheduled, and solar targets are all capped to this - match it to what the charger and your home's wiring/breaker support."
              },
              "value": 32,
              "min": 6,
              "max": 80
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "OCPP"
          },
          "children": [
            {
              "id": "idTag",
              "type": "text",
              "label": {
                "en": "Default idTag (RemoteStart)"
              },
              "hint": {
                "en": "Authorization tag sent when the app starts a charging session itself (manual/schedule/solar). By default any idTag is accepted, so this only needs to match something if you've enabled an idTag whitelist in the app's own settings."
              },
              "value": "CHARGEIQ"
            },
            {
              "id": "meterSampleIntervalSec",
              "type": "number",
              "label": {
                "en": "MeterValues interval (s)"
              },
              "hint": {
                "en": "How often the charger itself is configured to report power/current/voltage/energy (OCPP MeterValues), in seconds. Lower values give more responsive solar tracking and a livelier dashboard, at the cost of more OCPP traffic."
              },
              "value": 10,
              "min": 2,
              "max": 300
            },
            {
              "id": "writeThrottleMs",
              "type": "number",
              "label": {
                "en": "Min ms between profile writes"
              },
              "hint": {
                "en": "Minimum spacing between charging-profile (current limit) writes sent to the charger. Prevents a fast-moving solar target from flooding the charger with SetChargingProfile calls; it also delays how quickly a new target actually reaches the charger."
              },
              "value": 15000,
              "min": 1000,
              "max": 120000
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Load management"
          },
          "children": [
            {
              "id": "maxHouseholdW",
              "type": "number",
              "label": {
                "en": "Max household grid draw (W)"
              },
              "hint": {
                "en": "Charging is throttled in any mode so total grid import never exceeds this. Set 0 to disable."
              },
              "value": 14000,
              "min": 0,
              "max": 100000
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Solar surplus"
          },
          "children": [
            {
              "id": "marginW",
              "type": "number",
              "label": {
                "en": "Grid reserve margin (W)"
              },
              "hint": {
                "en": "Watts held back before offering surplus to the car. Positive reserves headroom and charges more conservatively; negative allows a bit of grid import. 0 targets breakeven."
              },
              "value": 0,
              "min": -3000,
              "max": 3000
            },
            {
              "id": "deadbandA",
              "type": "number",
              "label": {
                "en": "Deadband (A)"
              },
              "hint": {
                "en": "While already charging, ignore surplus changes smaller than this many amps. Stops the current limit from adjusting on every minor solar flicker."
              },
              "value": 1,
              "min": 0,
              "max": 10
            },
            {
              "id": "rampA",
              "type": "number",
              "label": {
                "en": "Max ramp per step (A)"
              },
              "hint": {
                "en": "While already charging, the most the current limit can change by on any single solar update. Smooths out sudden swings instead of jumping straight to the new target."
              },
              "value": 3,
              "min": 1,
              "max": 32
            },
            {
              "id": "minOnSec",
              "type": "number",
              "label": {
                "en": "Minimum on time (s)"
              },
              "hint": {
                "en": "Once solar charging starts, keep it running at least this long before a temporary drop in surplus is allowed to pause it."
              },
              "value": 180,
              "min": 0,
              "max": 3600
            },
            {
              "id": "minOffSec",
              "type": "number",
              "label": {
                "en": "Minimum off time (s)"
              },
              "hint": {
                "en": "Once paused (or before a first start), surplus must stay sufficient for at least this long before charging (re)starts. Prevents rapid pause/resume cycling."
              },
              "value": 180,
              "min": 0,
              "max": 3600
            },
            {
              "id": "solarStaleSec",
              "type": "number",
              "label": {
                "en": "Solar feed stale timeout (s)"
              },
              "hint": {
                "en": "If no solar reading arrives for this long, solar charging pauses as a fail-safe until fresh data returns."
              },
              "value": 60,
              "min": 10,
              "max": 600
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "power-flow": {
      "name": {
        "en": "Power Flow"
      },
      "height": 240,
      "settings": [],
      "id": "power-flow"
    }
  },
  "capabilities": {
    "charge_current_limit": {
      "type": "number",
      "title": {
        "en": "Current Limit"
      },
      "desc": {
        "en": "Target charging current"
      },
      "units": {
        "en": "A"
      },
      "icon": "/assets/capabilities/charge_current_limit.svg",
      "min": 6,
      "max": 32,
      "step": 1,
      "decimals": 0,
      "getable": true,
      "setable": true,
      "uiComponent": "slider"
    },
    "charge_mode": {
      "type": "enum",
      "title": {
        "en": "Charge Mode"
      },
      "desc": {
        "en": "Current mode: Manual, Scheduled or Solar"
      },
      "icon": "/assets/capabilities/charge_mode.svg",
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        {
          "id": "manual",
          "title": {
            "en": "Manual"
          }
        },
        {
          "id": "scheduled",
          "title": {
            "en": "Scheduled"
          }
        },
        {
          "id": "solar",
          "title": {
            "en": "Solar surplus"
          }
        }
      ]
    },
    "charger_status": {
      "type": "enum",
      "title": {
        "en": "Charger Status"
      },
      "desc": {
        "en": "Raw OCPP StatusNotification state"
      },
      "icon": "/assets/capabilities/charger_status.svg",
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        {
          "id": "Available",
          "title": {
            "en": "Available"
          }
        },
        {
          "id": "Preparing",
          "title": {
            "en": "Preparing"
          }
        },
        {
          "id": "Charging",
          "title": {
            "en": "Charging"
          }
        },
        {
          "id": "SuspendedEVSE",
          "title": {
            "en": "Suspended (EVSE)"
          }
        },
        {
          "id": "SuspendedEV",
          "title": {
            "en": "Suspended (EV)"
          }
        },
        {
          "id": "Finishing",
          "title": {
            "en": "Finishing"
          }
        },
        {
          "id": "Reserved",
          "title": {
            "en": "Reserved"
          }
        },
        {
          "id": "Unavailable",
          "title": {
            "en": "Unavailable"
          }
        },
        {
          "id": "Faulted",
          "title": {
            "en": "Faulted"
          }
        }
      ]
    },
    "measure_solar_surplus": {
      "type": "number",
      "title": {
        "en": "Solar Surplus"
      },
      "desc": {
        "en": "Excess solar power available to the charger"
      },
      "units": {
        "en": "W"
      },
      "icon": "/assets/capabilities/measure_solar_surplus.svg",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  }
}