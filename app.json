{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "family.bothe.chargeiq",
  "version": "1.0.0",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Charge IQ"
  },
  "description": {
    "en": "EV charging orchestration using OCPP."
  },
  "category": [
    "energy"
  ],
  "brandColor": "#16A34A",
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getSchedule": {
      "method": "GET",
      "path": "/getSchedule"
    },
    "setSchedule": {
      "method": "POST",
      "path": "/setSchedule"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "John Bothe",
    "email": "jbothe@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Charger fault"
        },
        "tokens": [
          {
            "name": "error_code",
            "type": "string",
            "title": {
              "en": "Error code"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charger_fault"
      },
      {
        "title": {
          "en": "Charger went offline"
        },
        "hint": {
          "en": "The OCPP connection to the charger dropped, or it stopped reporting entirely."
        },
        "tokens": [
          {
            "name": "last_seen",
            "type": "string",
            "title": {
              "en": "Last seen"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charger_offline"
      },
      {
        "title": {
          "en": "Charger came back online"
        },
        "hint": {
          "en": "The OCPP connection to the charger was re-established after an outage."
        },
        "tokens": [
          {
            "name": "offline_minutes",
            "type": "number",
            "title": {
              "en": "Minutes offline"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charger_online"
      },
      {
        "title": {
          "en": "Charging paused"
        },
        "tokens": [
          {
            "name": "current",
            "type": "number",
            "title": {
              "en": "Target current (A)"
            }
          },
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            }
          },
          {
            "name": "surplus",
            "type": "number",
            "title": {
              "en": "Solar surplus (W)"
            }
          },
          {
            "name": "session_energy",
            "type": "number",
            "title": {
              "en": "Session energy (kWh)"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_paused"
      },
      {
        "title": {
          "en": "Charging started"
        },
        "tokens": [
          {
            "name": "current",
            "type": "number",
            "title": {
              "en": "Target current (A)"
            }
          },
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            }
          },
          {
            "name": "surplus",
            "type": "number",
            "title": {
              "en": "Solar surplus (W)"
            }
          },
          {
            "name": "session_energy",
            "type": "number",
            "title": {
              "en": "Session energy (kWh)"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_started"
      },
      {
        "title": {
          "en": "Charging stopped"
        },
        "tokens": [
          {
            "name": "current",
            "type": "number",
            "title": {
              "en": "Target current (A)"
            }
          },
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            }
          },
          {
            "name": "surplus",
            "type": "number",
            "title": {
              "en": "Solar surplus (W)"
            }
          },
          {
            "name": "session_energy",
            "type": "number",
            "title": {
              "en": "Session energy (kWh)"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_stopped"
      },
      {
        "title": {
          "en": "Charge mode changed"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "mode_changed"
      },
      {
        "title": {
          "en": "Vehicle connected"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "vehicle_connected"
      },
      {
        "title": {
          "en": "Vehicle disconnected"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "vehicle_disconnected"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Charger !{{is|is not}} online"
        },
        "hint": {
          "en": "Whether the charger currently has an OCPP connection to Homey. Pair with a repeating trigger to alert on a long outage."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charger_is_online"
      },
      {
        "title": {
          "en": "!{{Is|Is not}} charging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "is_charging"
      },
      {
        "title": {
          "en": "Charge mode !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "Charge mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "manual",
                "label": {
                  "en": "Manual"
                }
              },
              {
                "id": "scheduled",
                "label": {
                  "en": "Scheduled"
                }
              },
              {
                "id": "solar",
                "label": {
                  "en": "Solar surplus"
                }
              },
              {
                "id": "idle",
                "label": {
                  "en": "Idle"
                }
              }
            ]
          }
        ],
        "id": "mode_is"
      },
      {
        "title": {
          "en": "!{{Is|Is not}} within a schedule window"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "within_schedule"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Resume automatic mode"
        },
        "hint": {
          "en": "Clear a manual override so the charger returns to Scheduled/Solar/Idle"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "resume_automatic"
      },
      {
        "title": {
          "en": "Set current limit"
        },
        "titleFormatted": {
          "en": "Set current limit to [[current]] A"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "range",
            "name": "current",
            "title": {
              "en": "Current (A)"
            },
            "min": 6,
            "max": 80,
            "step": 1,
            "value": 16,
            "label": " A",
            "labelDecimals": 0
          }
        ],
        "id": "set_current_limit"
      },
      {
        "title": {
          "en": "Start charging"
        },
        "hint": {
          "en": "Manual start until the next schedule boundary"
        },
        "titleFormatted": {
          "en": "Start charging at [[current]] A"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "range",
            "name": "current",
            "title": {
              "en": "Current (A)"
            },
            "min": 6,
            "max": 32,
            "step": 1,
            "value": 16,
            "label": " A",
            "labelDecimals": 0
          }
        ],
        "id": "start_charging"
      },
      {
        "title": {
          "en": "Stop charging"
        },
        "hint": {
          "en": "Manual stop until the next schedule boundary"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "stop_charging"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "OCPP Smart EV Charger"
      },
      "class": "evcharger",
      "capabilities": [
        "evcharger_charging",
        "charge_current_limit",
        "charge_current_applied",
        "charge_mode",
        "evcharger_charging_state",
        "session_duration",
        "meter_power.session",
        "measure_solar_surplus",
        "measure_power",
        "measure_current",
        "measure_voltage",
        "meter_power",
        "alarm_generic"
      ],
      "capabilitiesOptions": {
        "charge_current_limit": {
          "title": {
            "en": "Manual Current"
          }
        },
        "evcharger_charging_state": {
          "title": {
            "en": "Charging State"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Fault"
          }
        },
        "meter_power": {
          "title": {
            "en": "Energy (total)"
          }
        },
        "measure_power": {
          "insights": false
        },
        "meter_power.session": {
          "title": {
            "en": "Energy (session)"
          },
          "insights": false
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/charger/assets/images/small.png",
        "large": "/drivers/charger/assets/images/large.png",
        "xlarge": "/drivers/charger/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "charger",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Household electrical"
          },
          "children": [
            {
              "id": "householdPhases",
              "type": "number",
              "label": {
                "en": "Household phases"
              },
              "hint": {
                "en": "How many phases your home's main supply has (independent of the EV charger's own Charger phases setting below - a single-phase charger on a 3-phase household connection is common). Used with Main fuse rating and Nominal voltage below to compute the household grid cap."
              },
              "value": 1,
              "min": 1,
              "max": 3,
              "step": 1
            },
            {
              "id": "voltage",
              "type": "number",
              "label": {
                "en": "Nominal voltage (V)"
              },
              "hint": {
                "en": "Grid voltage used for watt/amp conversions everywhere - with Household phases above for the household cap, and with the EV charger's own Charger phases setting for solar and charger-circuit calculations. Use the nominal value for your grid (e.g. 230) - it doesn't need to track the live measured voltage."
              },
              "value": 230,
              "min": 100,
              "max": 480
            },
            {
              "id": "maxHouseholdA",
              "type": "number",
              "label": {
                "en": "Household main fuse rating (A)"
              },
              "hint": {
                "en": "Your home's main fuse/breaker rating per phase, matching Household phases above - most main breakers are amp-rated, not watt-rated. Charging is throttled in any mode so total grid import never exceeds this. Set 0 to disable."
              },
              "value": 63,
              "min": 0,
              "max": 250
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "EV charger electrical"
          },
          "children": [
            {
              "id": "phases",
              "type": "number",
              "label": {
                "en": "Charger phases"
              },
              "hint": {
                "en": "How many phases the charger is wired on (1 or 3). Used with Nominal voltage (under Household electrical above) for solar and charger-circuit watt/amp conversions, and sent to the charger in every charging profile."
              },
              "value": 1,
              "min": 1,
              "max": 3,
              "step": 1
            },
            {
              "id": "minAmps",
              "type": "number",
              "label": {
                "en": "Minimum current (A)"
              },
              "hint": {
                "en": "Lowest current ever sent to the charger once it's told to charge - manual, scheduled, and solar targets are all floored to this. Also the surplus threshold: solar charging only starts once available surplus reaches at least this many amps."
              },
              "value": 6,
              "min": 1,
              "max": 32
            },
            {
              "id": "maxAmps",
              "type": "number",
              "label": {
                "en": "Maximum current (A)"
              },
              "hint": {
                "en": "Highest current ever sent to the charger, in any mode. Manual, scheduled, and solar targets are all capped to this - match it to what the charger and your home's wiring/breaker support."
              },
              "value": 32,
              "min": 6,
              "max": 80
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "EV charger circuit"
          },
          "children": [
            {
              "id": "sharedCircuitA",
              "type": "number",
              "label": {
                "en": "Charger circuit rating (A)"
              },
              "hint": {
                "en": "Set this if the charger's own circuit/breaker has a lower rating than the rest of the house - whether it's dedicated to the charger alone (e.g. a 32A breaker with nothing else on it) or shared with other equipment (e.g. a home battery inverter, or any other load). Charging is throttled in any mode so total current on that circuit never exceeds this. This is independent of the whole-household grid cap under Household electrical. Set 0 to disable."
              },
              "value": 0,
              "min": 0,
              "max": 100
            },
            {
              "id": "sharedCircuitIncludeSolar",
              "type": "checkbox",
              "label": {
                "en": "Charger circuit includes solar production"
              },
              "hint": {
                "en": "Enable if solar PV also feeds into the charger circuit above - its production is added as extra headroom on top of the circuit rating. Leave off if the circuit has nothing to do with your solar system (or you have none)."
              },
              "value": false
            },
            {
              "id": "sharedCircuitIncludeBattery",
              "type": "checkbox",
              "label": {
                "en": "Charger circuit includes home battery"
              },
              "hint": {
                "en": "Enable if a home battery inverter also feeds into the charger circuit above - its charge/discharge is netted into the circuit rating, and battery discharge blocks a schedule's boost-to-cap from treating it as spare capacity. Leave off if the circuit has nothing to do with a battery (or you have none)."
              },
              "value": false
            },
            {
              "id": "sharedCircuitBufferA",
              "type": "number",
              "label": {
                "en": "Charger circuit buffer (A)"
              },
              "hint": {
                "en": "Amps reserved on the charger circuit for anything not otherwise measured (e.g. inverter overhead, other appliances). Subtracted from the circuit rating before any of it is offered to the EV."
              },
              "value": 0,
              "min": 0,
              "max": 32
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "OCPP"
          },
          "children": [
            {
              "id": "idTag",
              "type": "text",
              "label": {
                "en": "Default idTag (RemoteStart)"
              },
              "hint": {
                "en": "Authorization tag sent when the app starts a charging session itself (manual/schedule/solar). ChargeIQ accepts any idTag, so this normally needs no changing - set it only if your charger is configured to require a particular tag."
              },
              "value": "CHARGEIQ"
            },
            {
              "id": "meterSampleIntervalSec",
              "type": "number",
              "label": {
                "en": "MeterValues interval (s)"
              },
              "hint": {
                "en": "How often the charger itself is configured to report power/current/voltage/energy (OCPP MeterValues), in seconds. Lower values give more responsive solar tracking and a livelier dashboard, at the cost of more OCPP traffic."
              },
              "value": 10,
              "min": 2,
              "max": 300
            },
            {
              "id": "writeThrottleMs",
              "type": "number",
              "label": {
                "en": "Min delay between profile writes (ms)"
              },
              "hint": {
                "en": "Minimum spacing between charging-profile (current limit) writes sent to the charger. Prevents a fast-moving solar target from flooding the charger with SetChargingProfile calls; it also delays how quickly a new target actually reaches the charger."
              },
              "value": 15000,
              "min": 1000,
              "max": 120000
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Solar surplus"
          },
          "children": [
            {
              "id": "solarEnabled",
              "type": "checkbox",
              "label": {
                "en": "Enable solar-surplus tracking"
              },
              "hint": {
                "en": "When off, the charger never derives Solar mode outside a schedule - it goes Idle (holds at 0A) instead. Manual and Scheduled modes are unaffected, and the surplus meter/household caps keep updating in the background so re-enabling takes effect immediately."
              },
              "value": true
            },
            {
              "id": "marginW",
              "type": "number",
              "label": {
                "en": "Grid reserve margin (W)"
              },
              "hint": {
                "en": "Watts held back before offering surplus to the EV. Positive reserves headroom and charges more conservatively; negative allows a bit of grid import. 0 targets breakeven."
              },
              "value": 0,
              "min": -3000,
              "max": 3000
            },
            {
              "id": "deadbandA",
              "type": "number",
              "label": {
                "en": "Deadband (A)"
              },
              "hint": {
                "en": "While already charging, ignore surplus changes smaller than this many amps. Stops the current limit from adjusting on every minor solar flicker."
              },
              "value": 0,
              "min": 0,
              "max": 10
            },
            {
              "id": "rampA",
              "type": "number",
              "label": {
                "en": "Max ramp per step (A)"
              },
              "hint": {
                "en": "While already charging, the most the current limit can change by on any single step. This is a sanity bound against one bad reading, not the thing that keeps the loop steady - Settle time below does that. Setting it low on top of a settle time only makes solar tracking sluggish."
              },
              "value": 8,
              "min": 1,
              "max": 32
            },
            {
              "id": "solarSettleSec",
              "type": "number",
              "label": {
                "en": "Settle time after a change (s)"
              },
              "hint": {
                "en": "After the solar target moves, hold it this long before moving again, so the next decision is made on a grid reading that already includes the last change. Your solar data arrives via the cloud and lags the charger's own meter by roughly 15 seconds; without this wait the charger counts its own increase as spare surplus and chases itself up and down. Raise it if you still see the current swinging, lower it for faster tracking. 0 disables."
              },
              "value": 45,
              "min": 0,
              "max": 300
            },
            {
              "id": "minOnSec",
              "type": "number",
              "label": {
                "en": "Minimum on time (s)"
              },
              "hint": {
                "en": "Once solar charging starts, keep it running at least this long before a temporary drop in surplus is allowed to pause it."
              },
              "value": 180,
              "min": 0,
              "max": 3600
            },
            {
              "id": "minOffSec",
              "type": "number",
              "label": {
                "en": "Minimum off time (s)"
              },
              "hint": {
                "en": "Once paused (or before a first start), surplus must stay sufficient for at least this long before charging (re)starts. Prevents rapid pause/resume cycling."
              },
              "value": 180,
              "min": 0,
              "max": 3600
            },
            {
              "id": "solarStaleSec",
              "type": "number",
              "label": {
                "en": "Solar feed stale timeout (s)"
              },
              "hint": {
                "en": "If no solar reading arrives for this long, solar charging pauses as a fail-safe until fresh data returns."
              },
              "value": 60,
              "min": 10,
              "max": 600
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Dashboard meters"
          },
          "children": [
            {
              "id": "peakSolarW",
              "type": "number",
              "label": {
                "en": "Peak solar production (W)"
              },
              "hint": {
                "en": "Your system's peak PV output, used only to show a % capacity meter on the dashboard widget's Solar tile. Set 0 to hide that meter."
              },
              "value": 0,
              "min": 0,
              "max": 100000
            },
            {
              "id": "peakBatteryChargeW",
              "type": "number",
              "label": {
                "en": "Peak battery charge (W)"
              },
              "hint": {
                "en": "Your battery's peak charge power, used only to show a % capacity meter on the dashboard widget's Battery tile while charging. Set 0 to hide that meter."
              },
              "value": 0,
              "min": 0,
              "max": 100000
            },
            {
              "id": "peakBatteryDischargeW",
              "type": "number",
              "label": {
                "en": "Peak battery discharge (W)"
              },
              "hint": {
                "en": "Your battery's peak discharge power, used only to show a % capacity meter on the dashboard widget's Battery tile while discharging. Set 0 to hide that meter."
              },
              "value": 0,
              "min": 0,
              "max": 100000
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "power-flow": {
      "name": {
        "en": "Power Flow"
      },
      "height": 218,
      "settings": [],
      "api": {
        "getState": {
          "method": "GET",
          "path": "/state"
        }
      },
      "id": "power-flow"
    }
  },
  "capabilities": {
    "charge_current_applied": {
      "type": "number",
      "title": {
        "en": "Applied Limit"
      },
      "desc": {
        "en": "Current limit the charger last accepted. Compare with Current Limit (what ChargeIQ decided) and Current (what the car is drawing)."
