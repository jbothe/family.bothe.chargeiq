{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "family.bothe.chargeiq",
  "version": "1.0.0",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Charge IQ"
  },
  "description": {
    "en": "EV charging orchestration using OCPP."
  },
  "category": [
    "energy"
  ],
  "brandColor": "#16A34A",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "John Bothe",
    "email": "jbothe@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Charging started"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_started"
      },
      {
        "title": {
          "en": "Charging stopped"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "charging_stopped"
      },
      {
        "title": {
          "en": "Charge mode changed"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "mode_changed"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "!{{Is|Is not}} charging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "is_charging"
      },
      {
        "title": {
          "en": "Charge mode !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "Charge mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "off",
                "label": {
                  "en": "Off"
                }
              },
              {
                "id": "scheduled",
                "label": {
                  "en": "Scheduled"
                }
              },
              {
                "id": "solar",
                "label": {
                  "en": "Solar surplus"
                }
              },
              {
                "id": "manual",
                "label": {
                  "en": "Manual"
                }
              }
            ]
          }
        ],
        "id": "mode_is"
      },
      {
        "title": {
          "en": "!{{Is|Is not}} within a schedule window"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "within_schedule"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Set current limit"
        },
        "titleFormatted": {
          "en": "Set current limit to [[current]] A"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "range",
            "name": "current",
            "title": {
              "en": "Current (A)"
            },
            "min": 6,
            "max": 31,
            "step": 1,
            "value": 16,
            "label": " A",
            "labelDecimals": 0
          }
        ],
        "id": "set_current_limit"
      },
      {
        "title": {
          "en": "Set charge mode"
        },
        "titleFormatted": {
          "en": "Set charge mode to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "off",
                "label": {
                  "en": "Off"
                }
              },
              {
                "id": "scheduled",
                "label": {
                  "en": "Scheduled"
                }
              },
              {
                "id": "solar",
                "label": {
                  "en": "Solar surplus"
                }
              },
              {
                "id": "manual",
                "label": {
                  "en": "Manual"
                }
              }
            ]
          }
        ],
        "id": "set_mode"
      },
      {
        "title": {
          "en": "Start charging"
        },
        "hint": {
          "en": "Manual start until the next schedule boundary"
        },
        "titleFormatted": {
          "en": "Start charging at [[current]] A"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          },
          {
            "type": "range",
            "name": "current",
            "title": {
              "en": "Current (A)"
            },
            "min": 6,
            "max": 31,
            "step": 1,
            "value": 16,
            "label": " A",
            "labelDecimals": 0
          }
        ],
        "id": "start_charging"
      },
      {
        "title": {
          "en": "Stop charging"
        },
        "hint": {
          "en": "Manual stop until the next schedule boundary"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=charger"
          }
        ],
        "id": "stop_charging"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "EV Charger"
      },
      "class": "evcharger",
      "capabilities": [
        "charge_mode",
        "evcharger_charging",
        "evcharger_charging_state",
        "charger_status",
        "measure_power",
        "measure_current",
        "measure_voltage",
        "meter_power",
        "charge_current_limit"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/charger/assets/images/small.png",
        "large": "/drivers/charger/assets/images/large.png",
        "xlarge": "/drivers/charger/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "charger",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Electrical"
          },
          "children": [
            {
              "id": "phases",
              "type": "number",
              "label": {
                "en": "Phases"
              },
              "value": 1,
              "min": 1,
              "max": 3,
              "step": 1
            },
            {
              "id": "voltage",
              "type": "number",
              "label": {
                "en": "Nominal voltage (V)"
              },
              "value": 230,
              "min": 100,
              "max": 480
            },
            {
              "id": "minAmps",
              "type": "number",
              "label": {
                "en": "Minimum current (A)"
              },
              "value": 6,
              "min": 1,
              "max": 32
            },
            {
              "id": "maxAmps",
              "type": "number",
              "label": {
                "en": "Maximum current (A)"
              },
              "value": 31,
              "min": 6,
              "max": 80
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "OCPP"
          },
          "children": [
            {
              "id": "idTag",
              "type": "text",
              "label": {
                "en": "Default idTag (RemoteStart)"
              },
              "value": "CHARGEIQ"
            },
            {
              "id": "meterSampleIntervalSec",
              "type": "number",
              "label": {
                "en": "MeterValues interval (s)"
              },
              "value": 10,
              "min": 2,
              "max": 300
            },
            {
              "id": "writeThrottleMs",
              "type": "number",
              "label": {
                "en": "Min ms between profile writes"
              },
              "value": 15000,
              "min": 1000,
              "max": 120000
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Solar surplus"
          },
          "children": [
            {
              "id": "marginW",
              "type": "number",
              "label": {
                "en": "Grid reserve margin (W)"
              },
              "hint": {
                "en": "Positive reserves headroom (charge less); negative allows some import."
              },
              "value": 0,
              "min": -3000,
              "max": 3000
            },
            {
              "id": "deadbandA",
              "type": "number",
              "label": {
                "en": "Deadband (A)"
              },
              "value": 1,
              "min": 0,
              "max": 10
            },
            {
              "id": "rampA",
              "type": "number",
              "label": {
                "en": "Max ramp per step (A)"
              },
              "value": 3,
              "min": 1,
              "max": 32
            },
            {
              "id": "minOnSec",
              "type": "number",
              "label": {
                "en": "Minimum on time (s)"
              },
              "value": 180,
              "min": 0,
              "max": 3600
            },
            {
              "id": "minOffSec",
              "type": "number",
              "label": {
                "en": "Minimum off time (s)"
              },
              "value": 180,
              "min": 0,
              "max": 3600
            },
            {
              "id": "solarStaleSec",
              "type": "number",
              "label": {
                "en": "Solar feed stale timeout (s)"
              },
              "value": 60,
              "min": 10,
              "max": 600
            },
            {
              "id": "belowMin",
              "type": "dropdown",
              "label": {
                "en": "When surplus below minimum"
              },
              "value": "pause",
              "values": [
                {
                  "id": "pause",
                  "label": {
                    "en": "Pause at 0A (keep session)"
                  }
                },
                {
                  "id": "stop",
                  "label": {
                    "en": "Stop the transaction"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "power-flow": {
      "name": {
        "en": "Power Flow"
      },
      "height": 240,
      "settings": [],
      "id": "power-flow"
    }
  },
  "capabilities": {
    "charge_current_limit": {
      "type": "number",
      "title": {
        "en": "Current Limit"
      },
      "desc": {
        "en": "Target charging current"
      },
      "units": {
        "en": "A"
      },
      "min": 6,
      "max": 31,
      "step": 1,
      "decimals": 0,
      "getable": true,
      "setable": true,
      "uiComponent": "slider"
    },
    "charge_mode": {
      "type": "enum",
      "title": {
        "en": "Charge Mode"
      },
      "desc": {
        "en": "Off, Scheduled, Solar surplus or Manual"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "off",
          "title": {
            "en": "Off"
          }
        },
        {
          "id": "scheduled",
          "title": {
            "en": "Scheduled"
          }
        },
        {
          "id": "solar",
          "title": {
            "en": "Solar surplus"
          }
        },
        {
          "id": "manual",
          "title": {
            "en": "Manual"
          }
        }
      ]
    },
    "charger_status": {
      "type": "enum",
      "title": {
        "en": "Charger Status"
      },
      "desc": {
        "en": "Raw OCPP StatusNotification state"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        {
          "id": "Available",
          "title": {
            "en": "Available"
          }
        },
        {
          "id": "Preparing",
          "title": {
            "en": "Preparing"
          }
        },
        {
          "id": "Charging",
          "title": {
            "en": "Charging"
          }
        },
        {
          "id": "SuspendedEVSE",
          "title": {
            "en": "Suspended (EVSE)"
          }
        },
        {
          "id": "SuspendedEV",
          "title": {
            "en": "Suspended (EV)"
          }
        },
        {
          "id": "Finishing",
          "title": {
            "en": "Finishing"
          }
        },
        {
          "id": "Reserved",
          "title": {
            "en": "Reserved"
          }
        },
        {
          "id": "Unavailable",
          "title": {
            "en": "Unavailable"
          }
        },
        {
          "id": "Faulted",
          "title": {
            "en": "Faulted"
          }
        }
      ]
    }
  }
}