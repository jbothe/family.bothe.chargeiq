{
  "name": { "en": "OCPP Smart EV Charger" },
  "class": "evcharger",
  "capabilities": [
    "evcharger_charging",
    "target_power",
    "target_power_mode",
    "evcharger_charging_state",
    "measure_power",
    "charge_current_applied",
    "charge_current_offered",
    "measure_current",
    "measure_voltage",
    "meter_power.session",
    "session_duration",
    "meter_power",
    "measure_solar_surplus",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "target_power": {
      "title": { "en": "Target Power" },
      "min": 0,
      "max": 7360,
      "step": 230,
      "excludeMin": 0,
      "excludeMax": 1380
    },
    "target_power_mode": {
      "title": { "en": "Charge Mode" },
      "values": [
        { "id": "homey", "title": { "en": "Manual" } },
        { "id": "scheduled", "title": { "en": "Scheduled" } },
        { "id": "solar", "title": { "en": "Solar surplus" } },
        { "id": "idle", "title": { "en": "Idle" } }
      ]
    },
    "evcharger_charging_state": {
      "title": { "en": "Charging State" }
    },
    "alarm_generic": {
      "title": { "en": "Fault" }
    },
    "meter_power": {
      "title": { "en": "Energy (total)" }
    },
    "measure_power": {
      "insights": false
    },
    "measure_current": {
      "title": { "en": "Drawn Current" }
    },
    "meter_power.session": {
      "title": { "en": "Energy (session)" },
      "insights": false
    }
  },
  "energy": {
    "evCharger": true,
    "meterPowerImportedCapability": "meter_power"
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": {
    "small": "/drivers/charger/assets/images/small.png",
    "large": "/drivers/charger/assets/images/large.png",
    "xlarge": "/drivers/charger/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "start",
      "navigation": { "next": "list_devices" }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
